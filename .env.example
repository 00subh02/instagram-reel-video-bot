BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Sirf in groups me chalega (comma se alag). Khali chhoda to sab groups me chalega.
ALLOWED_GROUP_IDS=-1004451914143,-1004334916764

# Hosting platform khud deta hai, local me 8000 rehne do
PORT=8000

# Download source: seowebchecker = SIRF ye site (default, recommended)
# (auto = site fail par yt-dlp | ytdlp = sirf yt-dlp)
DOWNLOAD_SOURCE=seowebchecker

# Telegram Bot API limit ~50MB, isliye 48 safe hai
MAX_FILE_MB=48

# Kitne video ek saath download ho
MAX_CONCURRENT=3
